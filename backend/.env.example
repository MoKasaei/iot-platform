PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/iot-platform
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Platform Administrator
ADMIN_ORGANIZATION_ID=ORG001

# Backend connection to the MQTT broker
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=replace-with-a-strong-shared-password
MQTT_CLIENT_ID=service-backend-command
